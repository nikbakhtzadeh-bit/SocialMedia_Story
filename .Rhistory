path <- "C:\\Users\\nikba\\OneDrive\\Desktop\\SocialMedia_Story\\index.qmd\\data.sav.sav"
mydata <- read_sav(path)
mydata$Q16_label <- factor(
mydata$Q16,
levels = c(2, 3, 4, 5, 6),
labels = c(
"Less than 2 hrs",
"3 hrs+",
"4 hrs+",
"5 hrs+",
"6 hrs+"
)
)
table(mydata$Q16_label)
par(mfrow = c(1, 3))
plot(
mydata$ProblematicUse,
mydata$Depression,
xlab = "Problematic social media use",
ylab = "Depression",
main = "Depression"
)
abline(lm(Depression ~ ProblematicUse, data = mydata))
plot(
mydata$ProblematicUse,
mydata$Anxiety,
xlab = "Problematic social media use",
ylab = "Anxiety",
main = "Anxiety"
)
abline(lm(Anxiety ~ ProblematicUse, data = mydata))
plot(
mydata$ProblematicUse,
mydata$Loneliness,
xlab = "Problematic social media use",
ylab = "Loneliness",
main = "Loneliness"
)
abline(lm(Loneliness ~ ProblematicUse, data = mydata))
par(mfrow = c(1, 1))
library(ggplot2)
ggplot(mydata, aes(x = ProblematicUse, y = Depression)) +
geom_point(alpha = 0.4) +
geom_smooth(method = "lm", se = TRUE) +
labs(
x = "Problematic social media use score",
y = "Depression score"
) +
theme_classic()
library(tidyr)
wellbeing_data <- pivot_longer(
mydata,
cols = c(Depression, Anxiety, Loneliness),
names_to = "Outcome",
values_to = "Score"
)
ggplot(wellbeing_data, aes(x = ProblematicUse, y = Score)) +
geom_point(alpha = 0.4) +
geom_smooth(method = "lm", se = TRUE) +
facet_wrap(~ Outcome, scales = "free_y") +
labs(
x = "Problematic social media use score",
y = "Well-being score"
) +
theme_classic()
